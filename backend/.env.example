# This file documents the variables Atlas needs. It is committed; the real .env is not.
# For the API, the live copy goes inside atlas/agents/pipeline/.env.
# For standalone intake in the ADK dev UI, use atlas/agents/intake/.env.
# Get a key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_api_key_here
GOOGLE_GENAI_USE_VERTEXAI=FALSE
DEFAULT_MODEL=gemini-3.5-flash-lite
ITINERARY_MODEL=gemini-3.6-flash
# Production uses live Search grounding with a Tier 1 billing-enabled key.
ENABLE_SEARCH_GROUNDING=TRUE
